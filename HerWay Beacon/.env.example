# ── HerWay Beacon configuration ───────────────────────────────────────────────
# Everything below is OPTIONAL. With no keys the app runs in clearly-labelled
# DEMO MODE (file-backed store, simulated routes, local rules assistant).

# Secret used to sign sessions and trusted-contact links, and to encrypt phone/email at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=
# Where the demo file store lives (default ./.data)
# SJ_DATA_DIR=.data
# Public origin used to build contact links (default: request origin)
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Database: MongoDB (Atlas or local) ──────────────────────────────────────────
# Setting MONGODB_URI switches the app to MongoDB Atlas.
# e.g. mongodb+srv://<user>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=saheli

# ── Database + auth (Alternative: Supabase / PostgreSQL) ───────────────────────
# When set (and MONGODB_URI not set), the app switches to Supabase Postgres + Supabase Auth.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Google Authentication (Login with Google) ─────────────────────────────────
# Create an OAuth 2.0 Web Client in Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins: http://localhost:3000 (and your production domain)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=


# ── Google Maps Platform ───────────────────────────────────────────────────────
# Server key: Routes API + Places API (New). Restrict by IP.
GOOGLE_MAPS_API_KEY=
# Browser key: Maps JavaScript API. Restrict by HTTP referrer.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── Meta Model API (Muse) ──────────────────────────────────────────────────────
# https://dev.meta.ai/docs/quickstart  (OpenAI-compatible Responses API)
MODEL_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3

# ── Web Push (trusted-contact notifications) ───────────────────────────────────
# Generate with: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ── Backend timers ─────────────────────────────────────────────────────────────
# On a long-running Node server the engine ticks itself every few seconds.
# On serverless, schedule GET /api/cron/tick every minute with header: Authorization: Bearer $CRON_SECRET
CRON_SECRET=
# TICK_INTERVAL_MS=5000
